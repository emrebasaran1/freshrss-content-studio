<?php
/** @var ContentStudioExtension $this */
$c=$this->config();$m=ContentStudioExtension::messages($this->language());$t=static fn($k)=>htmlspecialchars($m[$k]??$k,ENT_QUOTES,'UTF-8');$esc=static fn($s)=>htmlspecialchars((string)$s,ENT_QUOTES,'UTF-8');
$categories=FreshRSS_Factory::createCategoryDao()->listCategories();
?>

<?php endforeach ?>
<p><label><?= $t('bookmark_url') ?> <input type="url" name="linkding" value="<?= $esc($c['linkding']) ?>" placeholder="https://bookmarks.example.org/bookmarks/new"></label></p>
<p><label><?= $t('download_url') ?> <input type="url" name="metube" value="<?= $esc($c['metube']) ?>" placeholder="https://downloads.example.org"></label></p>

<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>">
<h2>Content Studio</h2><p><?= $t('setup_help') ?></p>
<p><label><?= $t('language') ?> <select name="language"><?php foreach(['auto'=>'Auto','en'=>'English','tr'=>'Türkçe','de'=>'Deutsch','fr'=>'Français','es'=>'Español','zh'=>'简体中文'] as $id=>$label): ?><option value="<?= $id ?>" <?= $c['language']===$id?'selected':'' ?>><?= $label ?></option><?php endforeach ?></select></label></p>
